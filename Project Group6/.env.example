# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
# (the same Google AI Studio key works for Gemma)
GEMINI_API_KEY=your-key-here

# Optional settings
# GEMMA_MODEL=gemma-4-26b-a4b-it     # or gemma-4-31b-it (slower, stronger)
# WHISPER_MODEL=base                 # tiny | base | small | medium (bigger = more accurate, slower)
